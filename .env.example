# Copy this file to .env and fill in real values.
# .env is ignored by .gitignore - NEVER commit real credentials.
#
# Scope of .env: secrets and service endpoints ONLY.
# All non-sensitive settings (model, MASTERY_ALPHA, thresholds, seed, paths)
# live in config.yaml, which is the single source of truth frozen at P6.
#
# Any OpenAI-compatible endpoint works: point OPENROUTER_BASE_URL at the
# local/other service and put its key in OPENROUTER_API_KEY.

OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
